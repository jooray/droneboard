    <string name="about_futo_swipe_license_title">Licence vah modelu FUTO</string>
    <string name="about_futo_swipe_license_unavailable">Text licence se nepodařilo načíst.</string>
    <string name="keyboard_tips_title">Tipy pro klávesnici</string>
    <string name="keyboard_tips_summary">Gesta, editační zkratky a rychlé akce</string>
    <string name="tip_trackpad_title">Touchpad na mezerníku a kurzor</string>
    <string name="tip_trackpad_body">Podržte mezerník a proměňte klávesnici v přesný touchpad, nebo přejeďte doleva a doprava po mezerníku pro pohyb kurzoru.</string>
    <string name="tip_edit_shortcuts_title">Editační zkratky (A / X / C / V / Z / Y)</string>
    <string name="tip_edit_shortcuts_body">Podržte A pro vybrat vše, X pro vyjmout, C pro kopírovat, V pro vložit, Z pro zpět a Y pro znovu.</string>
    <string name="tip_delete_swipe_title">Mazání celých slov tahem</string>
    <string name="tip_delete_swipe_body">Přejeďte doleva z klávesy mazání pro označení a smazání celých slov jedním pohybem.</string>
    <string name="tip_dictation_undo_title">Vrácení celého diktovaného bloku</string>
    <string name="tip_dictation_undo_body">Hned po dokončení hlasového diktování jednou klepněte na klávesu mazání a smažete celou nadiktovanou větu.</string>
    <string name="tip_quick_clips_title">Rychlé výstřižky a připnutá schránka</string>
    <string name="tip_quick_clips_body">Nedávno zkopírované odkazy, kódy a text se objeví nad klávesnicí na jedno klepnutí. Dlouhým stiskem položku připnete, přejetím doleva ji odeberete.</string>
    <string name="tip_resize_title">Velikost a poloha</string>
    <string name="tip_resize_body">Otevřete Změnu velikosti z lišty nástrojů a tažením upravte výšku, šířku nebo jednoruční polohu přímo na obrazovce.</string>
    <string name="tip_shift_symbols_title">Rychlá velká písmena a symboly</string>
    <string name="tip_shift_symbols_body">Přejeďte ze Shift nebo ?123 na jinou klávesu pro jedno velké písmeno či symbol. Označte text a klepnutím na Shift přepínejte velikost písmen.</string>
    <string name="tip_toolbar_incognito_title">Připínání nástrojů a anonymní režim</string>
    <string name="tip_toolbar_incognito_body">Dlouhým stiskem ikon v liště nástrojů je připnete k liště návrhů. Zapněte anonymní režim pro pozastavení učení slov a ukládání schránky.</string>
