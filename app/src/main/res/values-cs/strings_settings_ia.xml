    <string name="setup_tip_delete_title">Přejeďte klávesou mazání</string>
    <string name="setup_tip_delete_detail">Smažte celá slova jedním tahem</string>
    <string name="setup_tip_edit_title">Podržte A / X / C / V / Z / Y</string>
    <string name="setup_tip_edit_detail">Vybrat vše, vyjmout, kopírovat, vložit, zpět a znovu</string>
