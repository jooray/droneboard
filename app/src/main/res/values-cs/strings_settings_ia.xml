    <!-- Setup wizard -->
    <string name="setup_wizard_step_progress">Krok %1$d z %2$d</string>
    <string name="setup_welcome_subtitle">Offline psaní tahem, chytré návrhy a hlasové diktování — přímo v telefonu.</string>
    <string name="setup_step3_languages_title">Jazyky a psaní</string>
    <string name="setup_step3_languages_subtitle">Zkontrolujte jazyky a výchozí volby. Vše můžete později změnit v Nastavení.</string>
    <string name="setup_step3_languages_card_title">Jazyky psaní</string>
    <string name="setup_step3_languages_card_summary">Klepnutím na jazyk v Nastavení přepnete QWERTY / QWERTZ a nastavíte jazyky psaní tahem.</string>
    <string name="setup_step3_configure_languages">Vybrat jazyky a rozložení</string>
    <string name="setup_step3_autocorrect_title">Automatické opravy</string>
    <string name="setup_step3_autocorrect_summary">Droneboard nechává automatické opravy ve výchozím stavu vypnuté, aby se slova potichu nepřepisovala. Návrhy se stále zobrazují nad klávesnicí.</string>
    <string name="setup_step4_try_title">Vyzkoušejte Droneboard</string>
    <string name="setup_step4_try_subtitle">Klepněte nebo pište tahem níže a hned si novou klávesnici vyzkoušejte.</string>
    <string name="setup_step4_try_placeholder">Napište nebo potáhněte pár slov sem…</string>
    <string name="setup_step4_tips_title">Užitečné zkratky</string>
