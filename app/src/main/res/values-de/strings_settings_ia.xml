    <string name="setup_step3_autocorrect_title">Autokorrektur</string>
    <string name="setup_step3_autocorrect_summary">Droneboard lässt die Autokorrektur standardmäßig aus, damit Wörter nicht unbemerkt ersetzt werden. Vorschläge erscheinen weiterhin über der Tastatur.</string>
    <string name="setup_step4_try_title">Droneboard ausprobieren</string>
    <string name="setup_step4_try_subtitle">Tippe oder wische unten, um deine neue Tastatur direkt zu testen.</string>
