    <!-- Setup wizard -->
    <string name="setup_wizard_step_progress">Step %1$d of %2$d</string>
    <string name="setup_welcome_subtitle">Offline swipe typing, smart predictions, and voice dictation — right on your phone.</string>
    <string name="setup_step3_languages_title">Languages &amp; typing</string>
    <string name="setup_step3_languages_subtitle">Check your typing languages and defaults. You can change everything later in Settings.</string>
    <string name="setup_step3_languages_card_title">Typing languages</string>
    <string name="setup_step3_languages_card_summary">Tap a language to turn it on or off. All languages here have swipe typing and smart predictions.</string>
