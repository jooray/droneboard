    <string name="keyboard_tips_title">Keyboard tips</string>
    <string name="keyboard_tips_summary">Gestures, editing shortcuts, and quick actions</string>
    <string name="tip_trackpad_title">Spacebar trackpad &amp; cursor</string>
    <string name="tip_trackpad_body">Hold the spacebar to turn the keyboard into a precision trackpad, or slide left and right on the spacebar to move the cursor.</string>
    <string name="tip_edit_shortcuts_title">Editing shortcuts (A / X / C / V / Z / Y)</string>
    <string name="tip_edit_shortcuts_body">Long-press A to select all, X to cut, C to copy, V to paste, Z to undo, and Y to redo.</string>
    <string name="tip_delete_swipe_title">Swipe backspace to delete words</string>
    <string name="tip_delete_swipe_body">Drag left from the Delete key to highlight and remove whole words in one motion.</string>
    <string name="tip_dictation_undo_title">Dictation block undo</string>
    <string name="tip_dictation_undo_body">Right after voice dictation finishes, tap Backspace once to undo the entire dictated phrase.</string>
    <string name="tip_quick_clips_title">Quick Clips &amp; pinned clipboard items</string>
    <string name="tip_quick_clips_body">Recently copied links, codes, and text appear as one-tap pills above the keyboard. Long-press entries in Clipboard view to pin them, or swipe left to remove.</string>
    <string name="tip_resize_title">Size &amp; position</string>
    <string name="tip_resize_body">Open Resize from the toolbar to drag keyboard height, width, or one-handed position directly on screen.</string>
    <string name="tip_shift_symbols_title">Quick uppercase &amp; symbols</string>
    <string name="tip_shift_symbols_body">Swipe from Shift or ?123 to another key for a single capital letter or symbol. Select text and tap Shift to cycle letter case.</string>
    <string name="tip_toolbar_incognito_title">Toolbar pinning &amp; Incognito</string>
    <string name="tip_toolbar_incognito_body">Long-press toolbar icons to pin them to the suggestion strip. Enable Incognito mode to pause word learning and clipboard saving.</string>
