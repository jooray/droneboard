    <!-- Setup wizard -->
    <string name="setup_wizard_step_progress">Stap %1$d van %2$d</string>
    <string name="setup_welcome_subtitle">Offline veegtypen, slimme voorspellingen en spraakdicteren — rechtstreeks op je telefoon.</string>
    <string name="setup_step3_languages_title">Talen &amp; typen</string>
    <string name="setup_step3_languages_subtitle">Controleer je typtalen en standaardinstellingen. Je kunt alles later aanpassen in Instellingen.</string>
    <string name="setup_step3_languages_card_title">Typtalen</string>
    <string name="setup_step3_languages_card_summary">Tik op een taal in Instellingen om tussen QWERTY en QWERTZ te wisselen en veegtalen in te schakelen.</string>
    <string name="setup_step3_configure_languages">Talen &amp; indelingen kiezen</string>
    <string name="setup_step3_autocorrect_title">Autocorrectie</string>
    <string name="setup_step3_autocorrect_summary">Droneboard laat autocorrectie standaard uit zodat woorden niet ongemerkt worden herschreven. Suggesties blijven boven het toetsenbord staan.</string>
    <string name="setup_step4_try_title">Probeer Droneboard</string>
    <string name="setup_step4_try_subtitle">Tik of veeg hieronder om je nieuwe toetsenbord meteen te testen.</string>
    <string name="setup_step4_try_placeholder">Typ of veeg hier een paar woorden…</string>
