    <string name="about_futo_swipe_license_title">Licentie voor FUTO-modelgewichten</string>
    <string name="about_futo_swipe_license_unavailable">Licentietekst kon niet worden geladen.</string>
    <string name="keyboard_tips_title">Toetsenbordtips</string>
    <string name="keyboard_tips_summary">Gebaren, bewerkingssneltoetsen en snelle acties</string>
    <string name="tip_trackpad_title">Spatiebalk-touchpad &amp; cursor</string>
    <string name="tip_trackpad_body">Houd de spatiebalk ingedrukt om het toetsenbord als precisie-touchpad te gebruiken, of veeg links en rechts over de spatiebalk.</string>
    <string name="tip_edit_shortcuts_title">Bewerkingssneltoetsen (A / X / C / V / Z / Y)</string>
    <string name="tip_edit_shortcuts_body">Houd A ingedrukt voor alles selecteren, X voor knippen, C voor kopiëren, V voor plakken, Z voor ongedaan maken en Y voor opnieuw.</string>
    <string name="tip_delete_swipe_title">Veeg op Backspace om woorden te wissen</string>
    <string name="tip_delete_swipe_body">Sleep naar links vanaf de wistoets om hele woorden in één beweging te markeren en te verwijderen.</string>
    <string name="tip_dictation_undo_title">Gedicteerd blok ongedaan maken</string>
    <string name="tip_dictation_undo_body">Tik direct na het dicteren één keer op Backspace om het hele gedicteerde fragment te verwijderen.</string>
    <string name="tip_quick_clips_title">Snelle knipsels &amp; vastgezet klembord</string>
    <string name="tip_quick_clips_body">Recent gekopieerde links, codes en tekst verschijnen als knoppen boven het toetsenbord. Houd ingedrukt om vast te zetten of veeg naar links om te verwijderen.</string>
    <string name="tip_resize_title">Grootte &amp; positie</string>
    <string name="tip_resize_body">Open Formaat wijzigen via de werkbalk om hoogte, breedte of eenhandige positie direct op het scherm te verslepen.</string>
    <string name="tip_shift_symbols_title">Snelle hoofdletters &amp; symbolen</string>
    <string name="tip_shift_symbols_body">Veeg vanaf Shift of ?123 naar een andere toets voor één hoofdletter of symbool. Selecteer tekst en tik op Shift om hoofd- en kleine letters te wisselen.</string>
    <string name="tip_toolbar_incognito_title">Werkbalk vastzetten &amp; Incognito</string>
    <string name="tip_toolbar_incognito_body">Houd pictogrammen in de werkbalk ingedrukt om ze vast te zetten. Schakel Incognito in om woordleren en klembordopslag te pauzeren.</string>
