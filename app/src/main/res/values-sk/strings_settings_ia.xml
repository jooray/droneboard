    <string name="about_futo_swipe_license_title">Licencia váh modelu FUTO</string>
    <string name="about_futo_swipe_license_unavailable">Text licencie sa nepodarilo načítať.</string>
    <string name="keyboard_tips_title">Tipy pre klávesnicu</string>
    <string name="keyboard_tips_summary">Gestá, skratky na úpravy a rýchle akcie</string>
    <string name="tip_trackpad_title">Touchpad na medzerníku a kurzor</string>
    <string name="tip_trackpad_body">Podržte medzerník a premeňte klávesnicu na presný touchpad, alebo prejdite prstom doľava a doprava po medzerníku pre pohyb kurzora.</string>
    <string name="tip_edit_shortcuts_title">Skratky na úpravy (A / X / C / V / Z / Y)</string>
    <string name="tip_edit_shortcuts_body">Podržte A pre vybrať všetko, X pre vystrihnúť, C pre kopírovať, V pre prilepiť, Z pre späť a Y pre znova.</string>
    <string name="tip_delete_swipe_title">Mazanie celých slov ťahom</string>
    <string name="tip_delete_swipe_body">Potiahnite doľava z klávesu mazania a označte i zmažte celé slová jedným pohybom.</string>
    <string name="tip_dictation_undo_title">Vrátenie celého diktovaného bloku</string>
    <string name="tip_dictation_undo_body">Hneď po skončení hlasového diktovania ťuknite raz na kláves mazania a zmažete celú nadiktovanú vetu.</string>
    <string name="tip_quick_clips_title">Rýchle výstrižky a pripnutá schránka</string>
    <string name="tip_quick_clips_body">Nedávno skopírované odkazy, kódy a text sa objavia nad klávesnicou na jedno ťuknutie. Dlhým stlačením položku pripnete, potiahnutím doľava ju odstránite.</string>
    <string name="tip_resize_title">Veľkosť a poloha</string>
    <string name="tip_resize_body">Otvorte Zmenu veľkosti z panela nástrojov a potiahnutím upravte výšku, šírku alebo jednoručnú polohu priamo na obrazovke.</string>
    <string name="tip_shift_symbols_title">Rýchle veľké písmená a symboly</string>
    <string name="tip_shift_symbols_body">Potiahnite zo Shift alebo ?123 na iný kláves pre jedno veľké písmeno či symbol. Označte text a ťuknutím na Shift prepínajte veľkosť písmen.</string>
    <string name="tip_toolbar_incognito_title">Pripínanie nástrojov a Inkognito</string>
    <string name="tip_toolbar_incognito_body">Dlhým stlačením ikon v paneli nástrojov ich pripnete k lište návrhov. Zapnite Inkognito na pozastavenie učenia slov a ukladania schránky.</string>
