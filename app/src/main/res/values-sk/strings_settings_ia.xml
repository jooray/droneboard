    <!-- Setup wizard -->
    <string name="setup_wizard_step_progress">Krok %1$d z %2$d</string>
    <string name="setup_welcome_subtitle">Offline písanie ťahom, inteligentné návrhy a hlasové diktovanie — priamo v telefóne.</string>
    <string name="setup_step3_languages_title">Jazyky a písanie</string>
    <string name="setup_step3_languages_subtitle">Skontrolujte jazyky a predvolené nastavenia. Všetko môžete neskôr zmeniť v Nastaveniach.</string>
    <string name="setup_step3_languages_card_title">Jazyky písania</string>
    <string name="setup_step3_languages_card_summary">Klepnutím na jazyk v Nastaveniach prepnete QWERTY / QWERTZ a nastavíte jazyky písania ťahom.</string>
    <string name="setup_step3_configure_languages">Vybrať jazyky a rozloženia</string>
    <string name="setup_step3_autocorrect_title">Automatické opravy</string>
    <string name="setup_step3_autocorrect_summary">Droneboard necháva automatické opravy predvolene vypnuté, aby sa slová potichu neprepisovali. Návrhy sa stále zobrazujú nad klávesnicou.</string>
    <string name="setup_step4_try_title">Vyskúšajte Droneboard</string>
    <string name="setup_step4_try_subtitle">Ťukajte alebo píšte ťahom nižšie a hneď si klávesnicu vyskúšajte.</string>
    <string name="setup_step4_try_placeholder">Napíšte alebo potiahnite pár slov sem…</string>
    <string name="setup_step4_tips_title">Užitočné skratky</string>
